# Build context hygiene. Everything here is either irrelevant to the runtime
# image or actively unwanted in it.

# Rebuilt inside the image
frontend/node_modules
frontend/dist

# Not part of the app image: the ML pipeline is a separate concern, nothing in
# the API imports it, and it pulls in PyTorch. Sending it to the builder would
# add hundreds of megabytes to the context for no runtime benefit.
ml/
.github/
.git/
# Agent worktrees: a second checkout of this repo, hundreds of megabytes of
# build context that would be uploaded on every build and used by nothing.
.claude/

# Tests do not ship
backend/tests/
.pytest_cache
pytest.ini

# Local artefacts
**/__pycache__
*.pyc
backend/*.db
*.db
.env
.venv
venv/
