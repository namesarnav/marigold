# Marigold configuration.
#
# Copy to .env for local use, or set these as service variables in Railway.
# Every value here is a placeholder; nothing in this file is a real credential.
#
# Variables for the API service (backend/Dockerfile). The frontend service
# needs only BACKEND_URL; see the last section.
#
# Only the two under "Required" have no default. On Railway also set
# PUBLIC_URL; see "Public address".

# --- Required ----------------------------------------------------------------

# Google AI Studio key. Card generation is the only thing that needs it; auth,
# quizzes and the review queue all work without it.
GEMINI_API_KEY=your-google-ai-studio-key

# Signs access tokens and the session cookie. Generate with:
#   openssl rand -hex 32
# Changing it invalidates every existing session and every unused email link.
SECRET_KEY=generate-me-with-openssl-rand-hex-32

# --- Datastores --------------------------------------------------------------

# On Railway use the reference, not a pasted URL: ${{Postgres.DATABASE_URL}}.
# A pasted copy goes stale the moment the database is replaced. A bare
# postgresql:// scheme is rewritten to postgresql+psycopg:// automatically,
# because psycopg 3 is what ships and SQLAlchemy picks its driver from the URL.
DATABASE_URL=postgresql+psycopg://marigold:devpass@localhost:55432/marigold

# Backs the login rate limiter. On Railway: ${{Redis.REDIS_URL}}.
# Empty falls back to an in-process counter, which is per-worker and therefore
# only correct while the service runs a single process. Set it in production.
REDIS_URL=

# --- Public address ----------------------------------------------------------
#
# The address people open in the browser. On Railway that is the FRONTEND
# service's domain, because its nginx proxies /api to the API. Set it on the API
# service as a reference, so it follows the domain if that ever changes:
#
#   PUBLIC_URL=https://${{marigold-web.RAILWAY_PUBLIC_DOMAIN}}
#
# It fills in FRONTEND_BASE_URL, BACKEND_BASE_URL and CORS_ORIGINS, and sets
# COOKIE_SECURE=true for https. Leave those four unset unless overriding one.
# Local development leaves PUBLIC_URL empty and uses the localhost values below.
PUBLIC_URL=

FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
# Must be true anywhere reachable over the internet or the session cookie
# travels in cleartext. Derived from PUBLIC_URL.
COOKIE_SECURE=false

# SameSite on the refresh cookie. Leave it "lax": behind the nginx proxy the
# cookie is first-party. "none" is only for a frontend calling the API's own
# domain directly, and needs COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# --- Email -------------------------------------------------------------------

# console logs the message instead of sending it, so the app runs end to end
# with no AWS account. Real signups need ses, because with console the only
# copy of a verification link is in the server log.
EMAIL_BACKEND=console
SES_REGION=us-east-1
SES_FROM_EMAIL=no-reply@example.com
SES_CONFIGURATION_SET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Accounts ----------------------------------------------------------------

# Whether an unconfirmed account is blocked from the core features.
#
# Off by default right now, because nothing delivers the confirmation email:
# with EMAIL_BACKEND=console every password signup would wait forever. Turn it
# on once EMAIL_BACKEND=ses works. Turning it off does not mark anyone
# verified, so switching it back on restores every account's real state.
REQUIRE_EMAIL_VERIFICATION=false

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=30

# --- OAuth -------------------------------------------------------------------
#
# The sign-in buttons render from /api/auth/oauth/providers, which lists only
# the providers that have credentials — so with none set the login page shows
# no buttons rather than buttons that answer 503. Register the callback as
# https://<your-domain>/api/auth/oauth/<provider>/callback
#
# On Railway the callback goes on the FRONTEND domain, since nginx proxies it:
#   https://<marigold-web domain>/api/auth/oauth/google/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Rate limiting -----------------------------------------------------------

LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_ATTEMPT_WINDOW_SECONDS=900
RESEND_VERIFICATION_MAX_PER_HOUR=3
PASSWORD_RESET_MAX_PER_HOUR=3

# --- Runtime -----------------------------------------------------------------

LOG_LEVEL=INFO

# --- Database pool -----------------------------------------------------------
#
# SQLAlchemy's defaults are 5 plus 10 overflow, which is too small: past 15
# concurrent database users every further request blocks for the timeout and
# then returns 500. Keep DB_POOL_SIZE + DB_MAX_OVERFLOW at or below Postgres's
# max_connections divided by WEB_CONCURRENCY.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# uvicorn worker count. Raising it makes the in-process rate limiter incorrect,
# so set REDIS_URL first.
WEB_CONCURRENCY=1

# --- Frontend service (frontend/Dockerfile) ----------------------------------
#
# The API's public URL, scheme and host only, no path and no trailing slash.
# Read by nginx at container start, so changing it needs a restart, not a
# rebuild. On Railway set it as a reference on the frontend service:
#
#   BACKEND_URL=https://${{marigold-api.RAILWAY_PUBLIC_DOMAIN}}
#
# The container refuses to start without it, with a message saying so.
BACKEND_URL=
