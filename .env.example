# Every variable the service reads, in the order you need to care about them.
# Copy to .env for a local `docker run`, or paste the required block into
# Railway's service variables. Defaults live in backend/config.py.

# --- Required: the deploy will not start without these ----------------------

# Any long random string. Signs JWTs and the session cookie, so changing it
# logs everyone out. Generate one with:  openssl rand -hex 32
SECRET_KEY=

# Google AI Studio key. Card generation is the only thing that uses it, but the
# app refuses to boot without it being set — accounts, quizzes and the
# interaction log all work with a placeholder value.
GEMINI_API_KEY=

# --- Provided by Railway; set by hand only if you are not on Railway --------

# Add a Postgres database to the project and reference its variable, so the URL
# tracks the database rather than being a copy that goes stale:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# The bare postgresql:// scheme Railway hands out is rewritten to
# postgresql+psycopg:// on load (backend/config.py), so the reference above
# works as-is — SQLAlchemy would otherwise resolve it to psycopg2, which is not
# installed.
DATABASE_URL=postgresql+psycopg://user:pass@host:5432/marigold

# Add a Redis database and reference it the same way:
#   REDIS_URL=${{Redis.REDIS_URL}}
# Optional, but not really: without it the login rate limiter falls back to a
# per-process in-memory store, which resets on every redeploy.
REDIS_URL=

# RAILWAY_PUBLIC_DOMAIN is injected automatically, and backend/config.py
# derives FRONTEND_BASE_URL, BACKEND_BASE_URL, CORS_ORIGINS and COOKIE_SECURE
# from it. Set them explicitly only for a custom domain — an explicit value
# always wins over the derived one.
# FRONTEND_BASE_URL=https://marigold.example.com
# BACKEND_BASE_URL=https://marigold.example.com
# CORS_ORIGINS=https://marigold.example.com
# COOKIE_SECURE=true

# --- Optional ----------------------------------------------------------------

# console prints verification and reset emails to the log; ses sends them.
# Leaving this as console means a real user can never confirm their address.
EMAIL_BACKEND=console
SES_REGION=us-east-1
SES_FROM_EMAIL=no-reply@example.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OAuth. Each provider's redirect URI is
#   https://<your-domain>/api/auth/oauth/<provider>/callback
# and must be registered with the provider exactly. Sign-in buttons for a
# provider with no credentials configured will fail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

LOG_LEVEL=INFO
