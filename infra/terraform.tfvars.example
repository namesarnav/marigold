# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# Your own address. Gates SSH (22) and the Kubernetes API (6443).
# Find it with: curl -s https://checkip.amazonaws.com
ssh_allowed_cidr = "203.0.113.4/32"

# Contents of your public key, e.g. ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... you@example.com"

# Optional overrides:
# aws_region    = "us-east-1"
#
# t4g.small (default) is ~$18/mo all-in and fits the $20 ceiling.
# t4g.medium is the originally specced size but costs ~$32/mo on demand.
# instance_type = "t4g.medium"
